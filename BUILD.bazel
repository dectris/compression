load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

COPTS = select({
    "@platforms//os:windows": [
        "/W4",
        "/WX",
    ],
    "//conditions:default": [
        "-Wall",
        "-Wextra",
        "-Wundef",
        "-Werror",
    ],
})

CXX_STD_COPTS = select({
    "@platforms//os:windows": ["/std:c++20"],
    "//conditions:default": ["-std=c++20"],
})

# Suppresses the warnings of the third party TRPX headers on MSVC, which treats
# the `includes` of @trpx as regular include directories (other compilers use
# -isystem).
TRPX_COPTS = select({
    "@platforms//os:windows": [
        "/external:Iexternal/trpx/include",
        "/external:W0",
    ],
    "//conditions:default": [],
})

cc_library(
    name = "compression",
    srcs = [
        "src/compression.c",
    ],
    hdrs = [
        "src/compression.h",
    ],
    copts = COPTS + [
        "-Iexternal",
    ],
    deps = [
        ":trpx",
        "@bitshuffle",
        "@lz4",
        "@zstd",
    ],
)

# C++ implementation of COMPRESSION_TRPX.
cc_library(
    name = "trpx",
    srcs = [
        "src/trpx.cc",
    ],
    hdrs = [
        "src/compression.h",
        "src/trpx.h",
    ],
    copts = COPTS + CXX_STD_COPTS + TRPX_COPTS,
    deps = [
        "@trpx",
    ],
)

cc_test(
    name = "compression_test",
    srcs = [
        "src/compression_test.cc",
    ],
    copts = COPTS + CXX_STD_COPTS + TRPX_COPTS + [
        "-Iexternal",
    ],
    deps = [
        ":compression",
        "@bitshuffle",
        "@gtest",
        "@gtest//:gtest_main",
        "@trpx",
        "@zstd//:zstd_compress",
    ],
)
