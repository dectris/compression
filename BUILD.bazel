load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:public"])

COPTS = select({
    "@platforms//os:windows": [
        "/W4",
        "/WX",
    ],
    "//conditions:default": [
        "-Wall",
        "-Wextra",
        "-Wundef",
        "-Werror",
    ],
})

CXX_STD_COPTS = select({
    "@platforms//os:windows": ["/std:c++20"],
    "//conditions:default": ["-std=c++20"],
})

# Usage: `#include "dectris_compression/src/compression.h"`
cc_library(
    name = "compression",
    srcs = [
        "src/compression.c",
    ],
    hdrs = [
        "src/compression.h",
    ],
    copts = COPTS,
    include_prefix = "dectris_compression",
    deps = [
        ":trpx",
        "@bitshuffle",
        "@lz4",
        "@zstd",
    ],
)

# C++ implementation of COMPRESSION_TRPX.
cc_library(
    name = "trpx",
    srcs = [
        "src/trpx.cc",
    ],
    hdrs = [
        "src/compression.h",
        "src/trpx.h",
    ],
    copts = COPTS + CXX_STD_COPTS,
    # Required by targets including the TRPX headers to suppress the warnings
    # of the third party headers (-isystem, MSVC: /external:I).
    features = ["external_include_paths"],
    visibility = ["//visibility:private"],
    deps = [
        "@trpx",
    ],
)

cc_test(
    name = "compression_test",
    srcs = [
        "src/compression_test.cc",
    ],
    copts = COPTS + CXX_STD_COPTS,
    features = ["external_include_paths"],
    deps = [
        ":compression",
        "@bitshuffle",
        "@googletest//:gtest_main",
        "@trpx",
        "@zstd",
    ],
)
