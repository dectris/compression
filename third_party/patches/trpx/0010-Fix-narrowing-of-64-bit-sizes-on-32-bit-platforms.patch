From cac5805e6ecc0d62deac3dd881a9900684d8c7d6 Mon Sep 17 00:00:00 2001
From: Dirk Boye <dirk.boye@dectris.com>
Date: Fri, 16 Oct 2026 10:47:31 +0200
Subject: [PATCH] Fix narrowing of 64 bit sizes on 32 bit platforms

`number_of_values` and `number_of_frames` are parsed with `std::stoull`
and implicitly converted to `std::size_t`. On 32 bit platforms this
silently truncates large values, and MSVC warns about the possible loss
of data (C4244), which breaks builds with /WX. Convert with a helper that
throws `std::out_of_range` if the value does not fit into `std::size_t`.
---
 include/Terse.hpp | 16 ++++++++++++++--
 1 file changed, 14 insertions(+), 2 deletions(-)

diff --git a/include/Terse.hpp b/include/Terse.hpp
index 228dc9a..c7c1180 100644
--- a/include/Terse.hpp
+++ b/include/Terse.hpp
@@ -22,6 +22,8 @@
 #include <optional>
 #include <variant>
 #include <cmath>
+#include <limits>
+#include <stdexcept>
 #include "Bitqueue.hpp"
 #include "Unique_array.hpp"
 #include "XML_element.hpp"
@@ -959,13 +961,23 @@ private:
         else return std::nullopt;
     }();
     
+    // Converts a string to std::size_t. Throws std::out_of_range if the value does not fit, e.g. on 32 bit platforms.
+    static std::size_t f_stosize(std::string const& str) {
+        unsigned long long const val = std::stoull(str);
+        if constexpr (sizeof(std::size_t) < sizeof(unsigned long long)) {
+            if (val > std::numeric_limits<std::size_t>::max())
+                throw std::out_of_range("Terse: value does not fit into std::size_t");
+        }
+        return static_cast<std::size_t>(val);
+    }
+    
     template <typename STREAM> requires std::derived_from<STREAM, std::istream>
     Terse(STREAM& istream, XML_element const& xmle) {
         if (!istream.eof()) {
             d_prolix_bits = unsigned(std::stoul(xmle.attribute("prolix_bits")));
             d_signed = std::stoul(xmle.attribute("signed"));
             d_block = std::stoul(xmle.attribute("block"));
-            d_size = std::stoull(xmle.attribute("number_of_values"));
+            d_size = f_stosize(xmle.attribute("number_of_values"));
             std::istringstream dim_str(xmle.attribute("dimensions"));
             unsigned int d;
             while (dim_str >> d)
@@ -978,7 +990,7 @@ private:
                     istream.read(d_metadata.back().data(), val);
                 }
             }
-            d_terse_frames.resize(std::stoull(xmle.attribute("number_of_frames")));
+            d_terse_frames.resize(f_stosize(xmle.attribute("number_of_frames")));
             for (auto& frame : d_terse_frames)
                 frame = std::vector<std::uint8_t>(); // Initialize each element to an empty vector
             if (xmle.attribute("memory_sizes_of_frames") == "")
